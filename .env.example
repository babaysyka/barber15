# Supabase → Project Settings → Database → Connection string.
# Transaction pooler, порт 6543. В конец добавить ?pgbouncer=true
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Тот же проект, Session pooler или Direct connection, порт 5432.
# Эту строку Prisma берёт для миграций.
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Project Settings → API. service_role только на сервере, во frontend не класть.
SUPABASE_URL="https://fcvfrerknmarxrusjpuk.supabase.co"

SUPABASE_SERVICE_ROLE_KEY=""

# BotFather → /newbot. Токен проверяет initData и webhook. Username без @ нужен для ссылки t.me.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# HTTPS-адрес Mini App. Кнопка «Записаться» в боте открывает его. Тот же адрес нужен в CORS.
MINIAPP_URL=""
# Случайная строка. Telegram присылает её в заголовке webhook, если секрет задан при setWebhook.
TELEGRAM_WEBHOOK_SECRET=""
# Секрет заголовка x-cron-secret. Тот же ключ лежит в vault под именем cron_secret.
CRON_SECRET=""
# Первый вход в /admin/login. Пароль не короче 8 символов. Если администратора ещё нет, API создаст его при старте.
ADMIN_LOGIN=""
ADMIN_PASSWORD=""
# Подпись httpOnly-cookie сессии. Случайная строка от 16 символов.
ADMIN_SESSION_SECRET=""
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
VITE_API_URL=""
CORS_ORIGIN="http://localhost:3000"
